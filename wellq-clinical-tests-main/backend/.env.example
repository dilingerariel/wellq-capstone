# Required deployment decisions; no usable credentials are supplied.
ENVIRONMENT=development
WELLQ_DEBUG=false
MONGODB_DB=wellq_test
# MONGODB_URI must target an authenticated replica set, never a clinical DB for tests.
MONGODB_URI=
JWT_ALGORITHM=RS256
# Configure either a trusted RSA public PEM or the issuer's HTTPS JWKS URL.
JWT_PUBLIC_KEY=
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_MAX_LIFETIME_SECONDS=3600
CORS_ORIGINS=[]
WELLQ_DEMO_AUTH_ENABLED=false
# Keep empty to generate an ephemeral key only for a single local demo process.
WELLQ_DEMO_JWT_PRIVATE_KEY=
# Enable only for the isolated synthetic presentation deployment (ENVIRONMENT=test).
WELLQ_DEMO_MONGO_STORAGE_ENABLED=false
WELLQ_DEMO_PUBLIC_API_BASE_URL=
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CREDENTIALS_PATH=
CLAMAV_HOST=
CLAMAV_PORT=3310
MAX_CLINICAL_FILE_BYTES=20971520
MAX_DOCUMENT_PAGES=30
MAX_IMAGE_PIXELS=40000000
MAX_REQUESTS_PER_MINUTE=120
AI_PROVIDER_APPROVED=false
CATALOG_CLINICALLY_APPROVED=false
