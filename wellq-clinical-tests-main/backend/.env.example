# FastAPI
APP_NAME=WellQ Clinical Tests API
DEBUG=False

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=wellq_clinical

# Google Cloud Storage
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=wellq-clinical-tests-dev
GCS_CREDENTIALS_PATH=./credentials.json

# JWT (obtener del equipo de auth)
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Upload
MAX_CLINICAL_FILE_BYTES=20971520
ALLOWED_MIME_TYPES=["application/pdf", "image/jpeg", "image/png", "image/heic"]

# GCS URLs
SIGNED_URL_EXPIRATION_MINUTES=15
DOWNLOAD_URL_EXPIRATION_MINUTES=5

# Rate limiting
MAX_PENDING_UPLOADS=10
MAX_URL_REFRESHES_PER_UPLOAD=10
MAX_DOWNLOADS_PER_HOUR=100

# Malware scanning
ENABLE_MALWARE_SCAN=False
MALWARE_SCAN_TIMEOUT_SECONDS=30